{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Baboon theme",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "The name Settings shows. The theme's id is its file name."
    },
    "appearance": {
      "enum": [
        "dark",
        "light"
      ],
      "description": "Picks egui's base visuals and the fallback colours."
    },
    "extends": {
      "type": "string",
      "description": "Another theme's id: a built-in (baboon-dark, baboon-light, baboon-light-classic) or a file in this folder."
    },
    "palette": {
      "type": "object",
      "description": "Names for colours, used below as $name.",
      "propertyNames": {
        "pattern": "^[a-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
        "description": "#RGB, #RGBA, #RRGGBB or #RRGGBBAA (straight alpha, as in CSS), or $name from the palette."
      }
    },
    "colors": {
      "type": "object",
      "description": "Token id to colour.",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
          "description": "Editor panes, windows and the page behind tag fields. (Core)"
        },
        "text": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
          "description": "Body text and labels. (Core)"
        },
        "accent": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
          "description": "Selection fill and other emphasis. (Core)"
        },
        "panel.background": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
          "description": "Side panels: the tag browser, tile bars and import panes. (Core)"
        },
        "row.background": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
          "description": "Striped and faint rows, and the background of non-interactive widgets. (Core)"
        },
        "border": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
          "description": "Separators and borders between panes. (Core)"
        },
        "separator": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
          "description": "egui's separator lines and the outline of non-interactive widgets. (Core)"
        },
        "text.muted": {
          "type": "string",
          "pattern": "^(#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8}|\\$[a-z0-9_-]+)$",
